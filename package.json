{
  "name": "lightbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "FORCE_COLOR=1 pnpm -r --parallel dev 2>&1 | tee /tmp/lightbox.log",
    "build": "pnpm -r build",
    "server": "pnpm --filter @lightbox/server dev",
    "client": "pnpm --filter @lightbox/client dev",
    "mcp": "pnpm --filter @lightbox/mcp dev",
    "musicbox": "pnpm --filter @lightbox/musicbox dev",
    "kill": "pkill -f 'tsx watch src/index' ; pkill -f 'vite' ; true",
    "redev": "pnpm kill && sleep 1 && pnpm dev"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
